PORT=3000
LUMEN_DEMO=1
NODE_ENV=development
LUMEN_DB_PATH=./data/lumen.sqlite
# Production only: ADMIN_EMAIL, ADMIN_PASSWORD; demo data disabled
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:library@example.edu

# Koha pilot circulation; disabled unless all three fields are configured
# KOHA_BASE_URL=https://koha.example.edu
# KOHA_CLIENT_ID=
# KOHA_CLIENT_SECRET=
# KOHA_CIRCULATION_ENABLED=0
# KOHA_PICKUP_LIBRARY_ID=MAIN

# Koha R4 loan pilot requires KOHA_CIRCULATION_ENABLED=1
# KOHA_LOANS_ENABLED=0

# R5 verification-only return workflow requires BOTH R3/R4 flags
# KOHA_RETURNS_ENABLED=0

# Institutional OIDC (off unless all configured)
# OIDC_ISSUER=https://identity.example.edu
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://lumen.example.edu/api/auth/oidc/callback
# OIDC_ONLY=0

# OIDC_TOKEN_AUTH_METHOD=client_secret_post

# Optional PUBLIC library service metadata. HTTPS URLs, no credentials/secrets.
# LUMEN_INSTITUTION_NAME=
# LUMEN_SERVICE_TERMS_URL=
# LUMEN_PRIVACY_URL=
# LUMEN_ACCESSIBILITY_URL=
# LUMEN_SUPPORT_URL=
