# Minimal deployment contract for a persistent single-instance Node 24 host.
# NODE_ENV=production
# LUMEN_DEMO=0
# LUMEN_DB_PATH=/path/to/your/persistent/volume/lumen.sqlite
# Optional containment check for the host's mounted durable volume:
# LUMEN_STORAGE_ROOT=/path/to/your/persistent/volume
# ADMIN_EMAIL=library.operator@example.edu        # first boot only
# ADMIN_PASSWORD=strong password at least 12 chars # first boot only
# PORT=3000                                         # optional
#
# Optional feature flags: Koha, OIDC, Web Push and public institution metadata
# remain explicitly OFF unless configured per docs.
